{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "server.js",
    "lib/**/*.js",
    "ml/**/*.js",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "public",
    "tests",
    "Dataset",
    "MLTraining"
  ]
}
