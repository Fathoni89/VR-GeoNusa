# VR-GeoNusa — konfigurasi environment
# Salin file ini jadi .env dan isi dengan kredensial database sungguhan.
# JANGAN commit file .env (sudah di-gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=vrgeonusa
DB_PASSWORD=
DB_NAME=vr_geonusa

# Wajib untuk database kosong atau migrasi pertama akun admin legacy;
# nilainya tidak dicetak ke log dan boleh dihapus setelah proses berhasil.
BOOTSTRAP_ADMIN_PASSWORD=

PORT=4000
